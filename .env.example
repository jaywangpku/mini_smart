LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_LANGUAGE=zh-CN

# The official SDK also accepts LONGPORT_* names. Either naming style works in mini_smart.
# LONGPORT_APP_KEY=
# LONGPORT_APP_SECRET=
# LONGPORT_ACCESS_TOKEN=

# Optional: use https://openapi.longbridge.com.hk or .cn endpoint if your account/network needs it.
# LONGBRIDGE_HTTP_URL=

MINI_SMART_DB_PATH=data/market.sqlite
